# Export neutral configured paths outside this code tree; do not commit local credentials/data.
CRRT_CODE_ROOT=/path/to/10_Analysis_Code
CRRT_V2_DATA_DIR=/path/to/private/current/v2/data
CRRT_V2_CCW=/path/to/private/current/v2/data/ccw_final.rds
CRRT_DOD_RDS=/path/to/private/credentialed/subject_dod.rds
CRRT_PRIMARY_OUT=/path/to/private/isolated/primary
# RMST reads the accepted CH01 output; default B1000/seed20260602 is unchanged.
CRRT_CH01_CCW=/path/to/private/current/primary/ccw_ch01_dod.rds
CRRT_SECONDARY_CSV=/path/to/private/credentialed/secondary_outcomes_ch01.csv
CRRT_SECONDARY_OUT=/path/to/private/isolated/secondary
CRRT_ACIDBASE_RDS=/path/to/private/credentialed/acidbase_t0_v2.rds
CRRT_ACIDBASE_OUT=/path/to/private/isolated/acidbase
CRRT_ANCHOR_MINUS6_CCW=/path/to/private/current/anchor_minus6h/ccw_final.rds
CRRT_ANCHOR_STAGE2_CCW=/path/to/private/current/anchor_stage2/ccw_final.rds
CRRT_ANCHOR_OUT=/path/to/private/isolated/anchor
CRRT_RESCUE_WEIGHT_ROOT=/path/to/private/current/rescue-branches
