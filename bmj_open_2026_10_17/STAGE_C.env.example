# Code-only current result interfaces. Export paths to private same-version aggregates.
CRRT_CODE_ROOT=/path/to/10_Analysis_Code
CRRT_WORKSPACE_ROOT=/path/to/private/revision-workspace
CH01_PRIMARY_CSV=/path/to/private/current/ch01_primary_dod.csv
CRRT_CH01_CCW=/path/to/private/current/ccw_ch01_dod.rds
CRRT_L0_RESULT_RDS=/path/to/private/current/strictK3_v2_l0_only_sensitivity.rds
CRRT_DOD_RDS=/path/to/private/credentialed/subject_dod.rds
CRRT_FIG3_BRIDGE_OUT=/path/to/private/isolated/era-L0
CRRT_FIG3_BRIDGE_CSV=/path/to/private/current/BRIDGE_NEW_4.csv
CRRT_FIG3_SOFA_CSV=/path/to/private/current/strictK3_v2_sofa_strata_results.csv
# Original selector accepts matching NEW CH01 rows in either four-row or full eight-row anchor export.
CRRT_FIG3_ANCHOR_CSV=/path/to/private/current/anchor_original_eight_rows.csv
CRRT_FIG3_PATH_CSV=/path/to/private/current/strictK3_v2_path_adjusted_ipcw_results.csv
CRRT_FIG3_RESCUE_CSV=/path/to/private/current/strictK3_v2_rescue_sensitivity_model_results.csv
# Original aggregate interface templates provide original labels/order/N/early, never private patients.
CRRT_FIG3_FOREST_TEMPLATE=/path/to/private/original/forest-interface.csv
CRRT_FIG3_PATH_RESCUE_TEMPLATE=/path/to/private/original/path-rescue-interface.csv
CRRT_FIG3_ERA_TEMPLATE=/path/to/private/original/era-interface.csv
CRRT_FIG3_INTERFACE_OUT=/path/to/private/isolated/figure3-interface
# Set these to the assembly outputs after separately authorized execution.
FIG3_FOREST_CSV=/path/to/private/isolated/figure3-interface/NEW_inputs/forest.csv
FIG3_PATH_RESCUE_CSV=/path/to/private/isolated/figure3-interface/NEW_inputs/path_rescue.csv
FIG3_QAPH_CSV=/path/to/private/isolated/figure3-interface/NEW_inputs/era.csv
CRRT_FIG3_CH01_DIR=/path/to/private/isolated/figure3-interface/NEW_inputs/ch01
CRRT_FIG3_OUT=/path/to/private/isolated/figure3-plot
FIG5_BANDSCAN_CSV=/path/to/private/current/original-bandscan-export-interface.csv
CRRT_FIG_S3_OUT=/path/to/private/isolated/sofa-bandscan-plot
FIG5_DPI=600

CRRT_FALSIFICATION_OUT=/path/to/private/isolated/six-row-diagnostics
